# Example configuration for the content automator script
# Copy this to .env and modify the paths as needed.

# The root directory to search for codebases.
SOURCE_DIRECTORY=/path/to/your/dev/folder

# The path to the 'content' directory of your Quartz installation.
QUARTZ_CONTENT_DIRECTORY=/path/to/your/quartz/viscera/content

# A comma-separated list of content types to aggregate.
# Valid options: descriptions, visceras, codebases
# To aggregate multiple types, separate them with a comma, e.g.: CONTENT_TYPES_TO_AGGREGATE=descriptions,visceras
CONTENT_TYPES_TO_AGGREGATE=descriptions
